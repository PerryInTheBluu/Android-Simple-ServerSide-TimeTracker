<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="?appCardBackgroundColor"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/itemSubjectGoalName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?appTextPrimaryColor"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Thermodynamik" />

        <TextView
            android:id="@+id/itemSubjectGoalEcts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?appTextHintColor"
            android:textSize="12sp"
            tools:text="5 ECTS" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/itemSubjectGoalBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressBackgroundTint="?appDividerColor"
        android:progressTint="@color/palette_green"
        tools:progress="40" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/itemSubjectGoalProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?appTextPrimaryColor"
            android:textSize="12sp"
            tools:text="12h / 90h" />

        <TextView
            android:id="@+id/itemSubjectGoalNoTarget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/subject_goal_no_target"
            android:textColor="?appTextHintColor"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>
